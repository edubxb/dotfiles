[user]
	name = Eduardo Bellido Bellido
	userConfigOnly = true
[init]
	defaultBranch = main
	templatedir = ~/.config/git/template/
[core]
	excludesfile = ~/.config/git/ignore
	pager = delta
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
[commit]
	verbose = true
[rebase]
	autoStash = true
	autoSquash = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	colorMoved = default
	indentHeuristic = true
	noprefix = true
	tool = diffbandit 
[difftool]
	prompt = false
[difftool "vimdiff"]
	cmd = nvim -d \"${LOCAL}\" \"${REMOTE}\"
[difftool "diffbandit"]
	cmd = diffbandit diff \"${LOCAL}\" \"${REMOTE}\"
[merge]
	conflictStyle = zdiff3
	tool = diffbandit 
[mergetool]
	keepBackup = false
	prompt = false
[mergetool "codediff"]
  cmd = nvim \"${MERGED}\" -c \"CodeDiff merge \\\"${MERGED}\\\"\"
[mergetool "diffbandit"]
	cmd = diffbandit merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\" --path \"$MERGED\"
	trustExitCode = true
[delta]
	features = side-by-side line-numbers
	hyperlinks = true
	navigate = true
[interactive]
	diffFilter = delta --color-only
[log]
	date = format:%F %R
[pretty]
	simpleline = %C(bold)%m %h%Creset %C(cyan)%ad %Creset%s
[alias]
	again = "!f() { git commit --amend --reuse-message=HEAD; git push --force-with-lease; }; f"
	aliases = config --get-regexp alias
	amend = commit --amend --reuse-message=HEAD
	bcl = "!f() { local ref=\"$(git default-branch)\"; [ -n \"$1\" ] && ref=\"$1\"; git log --no-merges --oneline --boundary --left-right $(git branch --show-current)...${ref}; }; f"
	blobs = "!git rev-list --objects --all | git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | grep blob | cut -d ' ' -f3- | sort -nr | numfmt --to=iec-i --suffix=B --padding=7 --round=nearest"
  bup = "!f() { \
      unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; \
      ref=${1:-$(git default-branch)}; cur=$(git branch --show-current); \
      [ -n \"$cur\" ] || { echo 'bup: not on a branch' >&2; return 1; }; \
      git fetch || return; \
      if [ \"$cur\" = \"$ref\" ]; then git pull --rebase --autostash; return; fi; \
      dirty() { [ -n \"$(git -C \"$1\" status --porcelain)\" ]; }; \
      here=$(git rev-parse --show-toplevel); \
      main=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); \
      hold=$(git worktree list --porcelain | awk -v b=\"branch refs/heads/$ref\" '/^worktree /{w=substr($0,10)} $0==b{print w; exit}'); \
      hs=; ms=; \
      if dirty .; then git stash push --include-untracked -m bup || return; hs=1; fi; \
      if [ -n \"$hold\" ]; then \
          git -C \"$hold\" pull --rebase --autostash; \
      elif [ \"$here\" = \"$main\" ]; then \
          git switch -q \"$ref\" && git pull --rebase && git switch -q \"$cur\"; \
      else \
          { ! dirty \"$main\" || { git -C \"$main\" stash push --include-untracked -m bup-main && ms=1; }; } && \
          git -C \"$main\" switch -q \"$ref\" && git -C \"$main\" pull --rebase && git -C \"$main\" checkout -q - && \
          { [ -z \"$ms\" ] || git -C \"$main\" stash pop --index; }; \
      fi && git rebase \"$ref\" && { [ -z \"$hs\" ] || git stash pop --index; } || \
      { echo \"bup: stopped, check 'git status' and 'git stash list'\" >&2; return 1; }; \
  }; f"
	cdiff = difftool --tool cdiff
	changed-files = "!git diffm --name-only"
	default-branch = "!git remote show origin | grep HEAD | cut -d' ' -f5"
	diffm = "!git diff $(git default-branch)"
	diffs = "!git diff --staged"
	diffu = diff @{u}
	fxc = "!f() { local ref=HEAD; [ -n \"$1\" ] && ref=\"$1\"; git commit --fixup=${ref}; }; f"
	ls-ignored = ls-files --others --ignored --exclude-standard
	mb = "!git switch $(git default-branch)"
	puf = push --force-with-lease
	rebaseme = "!f() { local ref=\"$(git default-branch)\"; [ -n \"$1\" ] && ref=\"$1\"; git rebase --autosquash -i $(git merge-base \"${ref}\" HEAD); }; f"
	shame = blame -w -M
	sqc = "!f() { local ref=HEAD; [ -n \"$1\" ] && ref=\"$1\"; git commit --squash=${ref}; }; f"
	stash-all = stash push --include-untracked
	trl = "!git reflog --all --pretty=raw | tig --pretty=raw"
	unstage = "!git restore --staged"
	ups = "!f() { local remote=\"origin\"; [ -n \"$1\" ] && remote=\"$1\"; git push -u \"${remote}\" $(git rev-parse --abbrev-ref HEAD); }; f"
	wip = "!f() { git commit -m \"WIP: $*\"; }; f"
[color "branch"]
	current = 229 bold
	local = 229
	remote = normal
[color "grep"]
	match = 11 bold
[color "interactive"]
	error = normal
	header = normal bold
	help = normal
	prompt = normal bold
[color "status"]
	branch = 229 bold
	changed = 98
	nobranch = 229 bold
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[include]
	path = ~/.config/git/config.personal
[includeIf "gitdir:~/Area51/work/"]
	path = ~/.config/git/config.work
