{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "system",
    "name": "carbonfox"
  },
  "animations": true,
  "cursor": {
    "style": "underline",
    "blinking": true
  },
  "keybinds": {
    "input.submit": "ctrl+return",
    "input.newline": "return"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "markdown": "rendered",
    "new_location": "inherit",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "plugins": [
    "@slkiser/opencode-quota",
    "opencode-subagent-statusline"
  ],
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "attention": {
    "notifications": true
  },
  "terminal": {
    "title": true
  }
}
