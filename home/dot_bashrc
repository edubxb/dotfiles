## if not running interactively, don't do anything ##
[[ -z "$PS1" ]] && return

## Bash options ##
shopt -s autocd
shopt -s cdspell
shopt -s checkjobs
shopt -s checkwinsize
shopt -s cmdhist
shopt -s direxpand
shopt -s dirspell
shopt -s extglob
shopt -s globstar
shopt -s histappend
shopt -s hostcomplete
shopt -s lithist

## Bash history ##
# History file path set in ~/config/shell/init.sh
HISTCONTROL='ignoreboth:erasedups'
HISTFILESIZE=3000
HISTIGNORE='&:[bf]g:cd:clear:exit:f[dp]:help?( *):history?(*):man?( *):pwd:* --help:* --version'
HISTSIZE=1000
HISTTIMEFORMAT='%F %T  '

## shell initialization ##
source "${HOME}/.config/shell/init.sh"

## tool-specific config ##
for config_file in \
    "${SHELL_CONFIG_PATH}/conf.d"/*.sh; do
  [[ -r "${config_file}" ]] && source "${config_file}"
done

## misecompsync completions (bash) ##
for f in "${XDG_DATA_HOME:-${HOME}/.local/share}/mise-completions/bash"/*; do
  [[ -f "${f}" ]] && source "${f}"
done

## aliases ##
source "${SHELL_CONFIG_PATH}/aliases.sh"
source "${SHELL_CONFIG_PATH}/alias-completions.sh"

## host-dependent config ##
[[ -f "${SHELL_CONFIG_PATH}/bashrc_$(hostname -s)" ]] && source "${SHELL_CONFIG_PATH}/bashrc_$(hostname -s)"
